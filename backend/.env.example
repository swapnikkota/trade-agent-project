# --- App ---
APP_ENV=local
LOG_LEVEL=INFO

# Comma-separated allowed CORS origins. Add your deployed frontend's URL
# here once it exists, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://trade-agent-frontend.onrender.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Phase 6: shared-secret auth ---
# Leave empty for local dev (auth OFF — anyone who can reach the backend
# can read/write any user_id's threads). Set to a random secret to require
# every request (except /health) to send it back via the X-API-Key header.
# If you set this, the frontend's VITE_API_KEY must match it exactly.
API_KEY=

# --- Model provider ---
# "ollama" = free, local (won't work once this backend is hosted somewhere
# that isn't your machine). "anthropic" = paid, cloud. "groq" = free,
# cloud — the default for the hosted deployment.
MODEL_PROVIDER=ollama

# Ollama settings (used when MODEL_PROVIDER=ollama)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic settings (used when MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Groq settings (used when MODEL_PROVIDER=groq) — get a free key at
# https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- MCP: Trade server (Phase 1 — single server, legacy fields) ---
# Fill in ONE of the two transport blocks below depending on how your MCP server is exposed.
# These are only read as a fallback when MCP_SERVERS (Phase 5, below) is empty.
# TRADE_MCP_URL ending in "/sse" uses the SSE transport; any other path
# (e.g. ".../mcp") is treated as streamable_http — see app/mcp/registry.py.

# Option A: HTTP transport (local mock_servers/ or SSE server)
TRADE_MCP_TRANSPORT=http
TRADE_MCP_URL=http://localhost:9000/sse

# Option A2: the real trades MCP server (streamable_http, once deployed)
# TRADE_MCP_TRANSPORT=http
# TRADE_MCP_URL=https://trades-mcp.onrender.com/mcp

# Option B: stdio transport (local subprocess)
# TRADE_MCP_TRANSPORT=stdio
# TRADE_MCP_COMMAND=python
# TRADE_MCP_ARGS=/path/to/your/trade_mcp_server.py

# --- MCP: Phase 5 — config-driven list of N servers ---
# Set this (as a single-line JSON array) to connect to more than one MCP
# server. When set, this takes over from TRADE_MCP_* above entirely.
# Uncomment to run the trade server plus the test mock_servers/market_data_server.py:
# MCP_SERVERS=[{"name":"trade","transport":"sse","url":"http://localhost:9000/sse"},{"name":"market_data","transport":"sse","url":"http://localhost:9001/sse"}]

# --- Langfuse Cloud ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Postgres (session/thread/message history) ---
# Local dev: use the individual fields below.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=swapnikkota
POSTGRES_PASSWORD=
POSTGRES_DB=trade_agent

# Hosted (Neon, etc.): set DATABASE_URL to the full connection string
# instead — it takes over from the individual POSTGRES_* fields above —
# and set POSTGRES_SSL=true (Neon requires SSL; see app/db/session.py for
# why this is a separate flag rather than a "?sslmode=require" in the URL).
# DATABASE_URL=postgresql://user:password@host/neondb
# POSTGRES_SSL=true
#
# If this database is shared with another app via separate schemas (e.g.
# one Neon project's "neondb" database holding both this app's
# "trade_agent" schema and trades-api's "tradesdb" schema, rather than two
# separate databases), also set POSTGRES_SCHEMA so this app's tables land
# in — and get looked up from — the right one instead of "public".
# POSTGRES_SCHEMA=trade_agent

# How many most-recent messages to feed back into the agent as context
HISTORY_WINDOW_SIZE=20

